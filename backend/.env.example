# Copy to backend/.env and fill in the values. NEVER commit the .env file.
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_hex(32))"

FLASK_ENV=development
FLASK_DEBUG=1

# Required: the application will not start without them.
SECRET_KEY=
JWT_SECRET_KEY=

# Database. Default: sqlite:///backend/app.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/expapp

# Allowed CORS origins, comma-separated.
# In production this must be the real frontend domain.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Mail (leave empty to disable sending in development).
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# URLs used to build password recovery links.
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# In production the frontend should be served over HTTPS and CORS_ORIGINS
# should contain only the real domain.

# Superuser for `flask create-su`. If ADMIN_PASSWORD is empty, the command
# generates a random password and prints it once.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@local.com
ADMIN_PASSWORD=

# Comma-separated administrator emails.
ADMINS=

# Public registration (disabled by default).
ALLOW_REGISTRATION=0
PASSWORD_MIN_LENGTH=8

# Token lifetimes in seconds.
ACCESS_TOKEN_EXPIRES=86400
REFRESH_TOKEN_EXPIRES=604800
RESET_TOKEN_EXPIRES=3600
JWT_ISSUER=expapp

# Rate limiting. With multiple workers use Redis in production:
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_ENABLED=1

# Uploads
# UPLOAD_FOLDER=
MAX_CONTENT_LENGTH=16777216
MAX_FILE_SIZE=8388608

BCRYPT_LOG_ROUNDS=13
